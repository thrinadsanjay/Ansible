{
  "id": "sanjay-lab",
  "realm": "sanjay-lab",
  "enabled": true,
  "clients": [
    {
      "clientId": "grafana",
      "protocol": "openid-connect",
      "name": "Grafana",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "secret": "grafanaclientsecret",
      "redirectUris": [
        "http://grafana:3000/*"
      ],
      "webOrigins": ["*"],
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true
    },
    {
      "clientId": "semaphore",
      "protocol": "openid-connect",
      "name": "Semaphore",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "secret": "semaphoreclientsecret",
      "redirectUris": ["http://semaphore:3000/*"],
      "webOrigins": ["*"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://semaphore:3000"
    }
  ]
}
